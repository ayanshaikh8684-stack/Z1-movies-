# Example Keystore Properties for Z1 Movies Release Signing
# Copy this file to 'keystore.properties' or define in ~/.gradle/gradle.properties
# NEVER commit your actual keystore or passwords to version control.

RELEASE_STORE_FILE=/path/to/your/release-key.jks
RELEASE_STORE_PASSWORD=your_store_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password
